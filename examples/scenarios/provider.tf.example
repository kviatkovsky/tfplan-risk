# Shared provider block for scenarios. `make fixtures` copies it next to each
# scenario as provider.tf and points the endpoints at LocalStack.
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region                      = "eu-central-1"
  access_key                  = "test"
  secret_key                  = "test"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true
  s3_use_path_style           = true

  default_tags {
    tags = {
      Project     = "demo"
      Environment = "staging"
    }
  }
}
